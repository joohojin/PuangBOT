{
  "providers": {
    "local-ollama": {
      "type": "ollama",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434",
      "privacy": "local",
      "api_key_env": null,
      "timeout": 120
    },
    "openrouter-main": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "https://openrouter.ai/api/v1",
      "privacy": "external",
      "api_key_env": "OPENROUTER_API_KEY",
      "timeout": 180
    },
    "openai-main": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "https://api.openai.com/v1",
      "privacy": "external",
      "api_key_env": "OPENAI_API_KEY",
      "timeout": 180
    },
    "lmstudio-local": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "http://127.0.0.1:1234/v1",
      "privacy": "local",
      "api_key_env": null,
      "timeout": 180
    }
  }
}
